generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  MERCHANDISER
  SUPERVISOR
  BUYER
  ADMIN
}

enum UnitType {
  OWN_UNIT
  SUBCONTRACTOR
}

enum Stage {
  KNITTING
  DYEING_WASHING
  PRINTING
  CUTTING
  STITCHING
  CHECKING
  FINISHING
}

enum RiskLevel {
  GREEN
  AMBER
  RED
}

enum ApprovalStatus {
  PENDING_REVIEW
  CONFIRMED
  OVERRIDDEN
}

enum IssueCategory {
  MACHINE_BREAKDOWN
  POWER_OUTAGE
  FABRIC_DEFECT
  SUBCONTRACTOR_DELAY
  LABOUR_SHORTAGE
  QUALITY_HOLD
  OTHER
}

enum AuditCategory {
  DATE_CHANGE
  FINANCIAL_IMPACT
  RISK_STATUS_CHANGE
  OVERTIME_AUTHORIZATION
  PRICE_UPDATE
  STAGE_OUTPUT
  ACCESS_CONTROL
  GATE_PASS_EVENT
  DISCOUNT_PENALTY
}

enum GatePassStatus {
  DISPATCHED
  PARTIAL_RECEIVED
  COMPLETED
  OVERDUE
}

// ==========================================
// MODELS (Using CUID for K-Sortable, Anti-Enumeration IDs)
// ==========================================

model Buyer {
  id           String              @id @default(cuid())
  name         String
  code         String              @unique
  country      String?
  contactEmail String?
  orders       Order[]
  users        User[]
  magicLinks   BuyerMagicLink[]
  reports      WeeklyBuyerReport[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("buyers")
}

model Unit {
  id             String                @id @default(cuid())
  name           String
  code           String                @unique
  type           UnitType              @default(OWN_UNIT)
  location       String?
  orders         Order[]
  users          User[]
  milestones     TnaMilestone[]
  gatePasses     SubcontractGatePass[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("units")
}

model User {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  passwordHash       String
  name               String
  role               Role                   @default(SUPERVISOR)
  languagePreference String                 @default("ta") // "ta" or "en"
  phone              String?
  buyerId            String?
  buyer              Buyer?                 @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  assignedUnitId     String?
  assignedUnit       Unit?                  @relation(fields: [assignedUnitId], references: [id], onDelete: SetNull)
  productionUpdates  ProductionUpdate[]
  auditEvents        AuditEvent[]
  mitigationActions  RiskMitigationAction[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([role])
  @@index([buyerId])
  @@index([assignedUnitId])
  @@map("users")
}

model Order {
  id                String                @id @default(cuid())
  poNumber          String                @unique
  style             String
  description       String?
  totalQuantity     Int
  currency          String                @default("INR") // e.g. "INR", "GBP", "EUR", "USD"
  exchangeRate      Float                 @default(1.0)
  fobPricePerPiece  Float?
  encryptedFobPrice String?               // Optional AES-256-GCM encrypted commercial FOB value
  totalOrderValue   Float?
  exFactoryDate     DateTime
  orderDate         DateTime              @default(now())
  status            String                @default("ACTIVE")
  version           Int                   @default(0) // Optimistic concurrency lock
  deletedAt         DateTime?             // Soft delete timestamp for compliance audits
  buyerId           String
  buyer             Buyer                 @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  unitId            String
  unit              Unit                  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  orderLines        OrderLine[]
  milestones        TnaMilestone[]
  productionUpdates ProductionUpdate[]
  riskWarnings      RiskWarning[]
  auditEvents       AuditEvent[]
  gatePasses        SubcontractGatePass[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([buyerId])
  @@index([unitId])
  @@index([exFactoryDate])
  @@index([status])
  @@index([deletedAt])
  @@map("orders")
}

model OrderLine {
  id            String                 @id @default(cuid())
  orderId       String
  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  size          String                 // S, M, L, XL, etc.
  color         String
  plannedQty    Int
  completedQty  Int                    @default(0)
  updateLines   ProductionUpdateLine[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([orderId, size, color])
  @@index([orderId])
  @@map("order_lines")
}

model TnaMilestone {
  id                String                @id @default(cuid())
  orderId           String
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage             Stage
  sequenceOrder     Int                   // Sequence 1–7
  plannedStart      DateTime
  plannedEnd        DateTime
  bufferDaysAhead   Int                   @default(0)
  targetQuantity    Int
  completedQuantity Int                   @default(0)
  version           Int                   @default(0) // Optimistic concurrency lock
  deletedAt         DateTime?             // Soft delete timestamp
  unitId            String?
  unit              Unit?                 @relation(fields: [unitId], references: [id], onDelete: SetNull)
  productionUpdates ProductionUpdate[]
  riskWarnings      RiskWarning[]
  gatePasses        SubcontractGatePass[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([orderId, stage])
  @@unique([orderId, sequenceOrder])
  @@index([orderId])
  @@index([stage])
  @@index([deletedAt])
  @@map("tna_milestones")
}

model ProductionUpdate {
  id                   String                 @id @default(cuid())
  idempotencyKey       String                 @unique
  orderId              String
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  milestoneId          String
  milestone            TnaMilestone           @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  supervisorId         String
  supervisor           User                   @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  stage                Stage
  shift                String?                @default("DAY") // "DAY" or "NIGHT"
  machineLine          String?                // e.g. "Line 1", "Line 4B"
  goodQuantity         Int
  rejectedQuantity     Int                    @default(0)
  notes                String?                @db.Text
  audioFileUrl         String?                // S3 link to supervisor's raw Tamil audio note
  voiceDurationSeconds Int?                   // Audio recording duration in seconds
  clientEventAt        DateTime               @default(now())
  receivedAt           DateTime               @default(now())
  approvalStatus       ApprovalStatus         @default(PENDING_REVIEW)
  confirmedBy          String?
  confirmedAt          DateTime?
  photos               ProductionPhoto[]
  issueClassification  IssueClassification?
  sizeBreakdownLines   ProductionUpdateLine[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([orderId])
  @@index([milestoneId])
  @@index([supervisorId])
  @@index([approvalStatus])
  @@index([clientEventAt])
  @@index([milestoneId, clientEventAt(sort: Desc)])
  @@index([orderId, clientEventAt(sort: Desc)])
  @@map("production_updates")
}

model ProductionUpdateLine {
  id                 String           @id @default(cuid())
  productionUpdateId String
  productionUpdate   ProductionUpdate @relation(fields: [productionUpdateId], references: [id], onDelete: Cascade)
  orderLineId        String
  orderLine          OrderLine        @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  goodQuantity       Int
  rejectedQuantity   Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([productionUpdateId, orderLineId])
  @@index([productionUpdateId])
  @@index([orderLineId])
  @@map("production_update_lines")
}

model ProductionPhoto {
  id                 String           @id @default(cuid())
  productionUpdateId String
  productionUpdate   ProductionUpdate @relation(fields: [productionUpdateId], references: [id], onDelete: Cascade)
  s3Url              String
  stage              Stage
  approvalStatus     ApprovalStatus   @default(PENDING_REVIEW)
  isBuyerVisible     Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([productionUpdateId])
  @@index([isBuyerVisible])
  @@index([approvalStatus])
  @@index([productionUpdateId, isBuyerVisible])
  @@map("production_photos")
}

model RiskWarning {
  id                      String                 @id @default(cuid())
  orderId                 String
  order                   Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  milestoneId             String
  milestone               TnaMilestone           @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  riskLevel               RiskLevel
  requiredDailyRate       Float
  actualRollingRate       Float
  varianceQtyPerDay       Float
  projectedCompletionDate DateTime?
  daysLate                Int
  financialExposureRupees Float
  mathBreakdown           String                 @db.Text // JSON string
  mitigationPlan          String?                @db.Text
  approvalStatus          ApprovalStatus         @default(PENDING_REVIEW)
  isBuyerVisible          Boolean                @default(false)
  reviewedById            String?
  reviewedAt              DateTime?
  mitigationActions       RiskMitigationAction[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([orderId])
  @@index([milestoneId])
  @@index([riskLevel])
  @@index([approvalStatus])
  @@index([isBuyerVisible])
  @@index([orderId, approvalStatus, isBuyerVisible])
  @@map("risk_warnings")
}

model RiskMitigationAction {
  id                  String      @id @default(cuid())
  riskWarningId       String
  riskWarning         RiskWarning @relation(fields: [riskWarningId], references: [id], onDelete: Cascade)
  actionType          String      // e.g. "AUTHORIZE_OVERTIME", "ADD_STITCHING_LINE", "SPLIT_SUBCONTRACT"
  description         String      @db.Text
  addedDailyCapacity  Int         @default(0) // pcs/day added
  estimatedCostRupees Float       @default(0.0) // cost impact of mitigation
  authorizedById      String
  authorizedBy        User        @relation(fields: [authorizedById], references: [id], onDelete: Restrict)
  createdAt           DateTime    @default(now())

  @@index([riskWarningId])
  @@index([authorizedById])
  @@map("risk_mitigation_actions")
}

model SubcontractGatePass {
  id               String         @id @default(cuid())
  gatePassNumber   String         @unique
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  milestoneId      String
  milestone        TnaMilestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  dispatchedQty    Int
  receivedQty      Int            @default(0)
  dispatchedAt     DateTime       @default(now())
  expectedReturnAt DateTime
  actualReturnedAt DateTime?
  status           GatePassStatus @default(DISPATCHED)
  challanDocUrl    String?
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([milestoneId])
  @@index([unitId])
  @@index([status])
  @@map("subcontract_gate_passes")
}

model IssueClassification {
  id                 String           @id @default(cuid())
  productionUpdateId String           @unique
  productionUpdate   ProductionUpdate @relation(fields: [productionUpdateId], references: [id], onDelete: Cascade)
  category           IssueCategory
  confidenceScore    Float
  needsReview        Boolean          @default(false)
  isConfirmed        Boolean          @default(false)
  rawTamilText       String?          @db.Text
  translatedText     String?          @db.Text
  classifiedBy       String?          @default("AI")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([category])
  @@index([needsReview])
  @@index([isConfirmed])
  @@map("issue_classifications")
}

model AuditEvent {
  id                    String        @id @default(cuid())
  entityType            String        // Order, TnaMilestone, ProductionUpdate, RiskWarning, SubcontractGatePass
  entityId              String
  action                String        // e.g. "UPDATE_EX_FACTORY_DATE", "CONFIRM_RISK_WARNING", "LOG_FINANCIAL_PENALTY"
  category              AuditCategory @default(DATE_CHANGE)
  reasonCode            String        // mandatory reason code e.g. "BUYER_REVISED_SPEC", "FABRIC_DELAY"
  notes                 String?       @db.Text
  previousValue         String?       @db.Text // JSON diff string
  newValue              String?       @db.Text // JSON diff string
  financialImpactRupees Float?        // Money auditing: financial penalty or exposure in INR
  currency              String?       @default("INR")
  auditHash             String?       // SHA-256 tamper-evident integrity hash
  userId                String
  userRole              Role          @default(SUPERVISOR) // Role at time of action
  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId               String?
  order                 Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  timestamp             DateTime      @default(now())
  ipAddress             String?
  userAgent             String?

  @@index([entityType, entityId])
  @@index([category])
  @@index([userRole])
  @@index([userId])
  @@index([orderId])
  @@index([timestamp])
  @@map("audit_events")
}

model BuyerMagicLink {
  id         String    @id @default(cuid())
  token      String    @unique
  tokenHash  String?   @unique // Cryptographic SHA-256 hash for secure verification
  buyerId    String
  buyer      Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([token])
  @@index([tokenHash])
  @@index([buyerId])
  @@index([isActive, expiresAt])
  @@map("buyer_magic_links")
}

model WeeklyBuyerReport {
  id              String   @id @default(cuid())
  buyerId         String
  buyer           Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  weekNumber      Int
  year            Int
  fileFormat      String   @default("PDF") // "PDF" or "EXCEL"
  reportUrl       String
  summarySnapshot String   @db.Text // JSON snapshot of orders, run-rates, risk statuses
  orderCount      Int
  generatedById   String?
  generatedAt     DateTime @default(now())

  @@index([buyerId])
  @@index([year, weekNumber])
  @@map("weekly_buyer_reports")
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, used])
  @@map("password_reset_otps")
}
