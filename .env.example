# ==========================================
# THREADFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_PREFIX=/api/v1

# Primary Relational Database (PostgreSQL 16)
DATABASE_URL="postgresql://user:password@localhost:5432/threadflow_dev?schema=public"

# Read Replica Database URL (optional, for HA failover and read load-balancing)
REPLICA_DATABASE_URL="postgresql://user:password@localhost:5432/threadflow_dev?schema=public"

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000
DB_ENABLE_REPLICA_READS=false

# 32-byte (64 hex char) Master Key for Field-Level AES-256-GCM Encryption
ENCRYPTION_MASTER_KEY=your_64_character_hex_encryption_key_here

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_64_character_hex_access_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_64_character_hex_refresh_secret_here
JWT_REFRESH_EXPIRY=7d

# Simulated Factory Anchor Date
SIMULATED_TODAY_DATE="2026-11-02"

# AI Provider Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_gemini_api_key_here
AI_TIMEOUT_MS=3000
AI_CONFIDENCE_THRESHOLD=0.65

# Encrypted Object Storage (Photos & Audit Proofs)
S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
S3_REGION="ap-south-1"
S3_BUCKET="threadflow-production-evidence"
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
