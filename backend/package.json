{
  "name": "threadflow-backend",
  "version": "1.0.0",
  "description": "ThreadFlow Knitwear Production Intelligence & Risk Management Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "tsx tests/risk.test.ts && tsx tests/ai.fallback.test.ts && tsx tests/orders.test.ts && tsx tests/production.test.ts",
    "simulate:daily": "tsx scripts/simulate-daily-production.ts",
    "simulate:complete": "tsx scripts/simulate-daily-production.ts --all",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:calibrated": "tsx prisma/seed.ts --profile=calibrated",
    "seed:stress": "tsx prisma/seed.ts --profile=stress --stress-count=40",
    "seed:minimal": "tsx prisma/seed.ts --profile=minimal",
    "seed:master": "tsx prisma/seed.ts --profile=master-only",
    "seed:clean": "tsx prisma/seed.ts --profile=calibrated --clean"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
